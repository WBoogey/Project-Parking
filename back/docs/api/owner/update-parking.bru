meta {
  name: Update Parking
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/api/owner/parkings/{{parkingId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Updated Parking Name",
    "address": "456 New Street, Paris",
    "capacity": 150
  }
}

script:post-response {
  console.log("response", res.body);
}

tests {
  test("should return 200 on successful update", function() {
    expect(res.status).to.equal(200);
  });

  test("should have success status", function() {
    expect(res.body.status).to.equal("success");
  });

  test("should return updated parking data", function() {
    expect(res.body.data).to.have.property("id");
    expect(res.body.data).to.have.property("name");
    expect(res.body.data).to.have.property("address");
    expect(res.body.data).to.have.property("capacity");
  });
}

meta {
  name: Update Subscription
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/subscriptions/{{subscriptionId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "startDate": "2025-02-01",
    "endDate": "2025-11-30",
    "weeklySlots": [
      {"dayOfWeek": "tuesday", "startHour": "09:00", "endHour": "17:00"},
      {"dayOfWeek": "thursday", "startHour": "09:00", "endHour": "17:00"}
    ]
  }
}

script:post-response {
  console.log("response", res.body);
}

tests {
  test("should return 200 on successful update", function() {
    expect(res.status).to.equal(200);
  });

  test("should have success status", function() {
    expect(res.body.status).to.equal("success");
  });

  test("should return updated subscription data", function() {
    expect(res.body.data).to.have.property("id");
    expect(res.body.data).to.have.property("userId");
    expect(res.body.data).to.have.property("parkingId");
    expect(res.body.data).to.have.property("rateId");
    expect(res.body.data).to.have.property("startDate");
    expect(res.body.data).to.have.property("endDate");
    expect(res.body.data).to.have.property("weeklySlots");
  });

  test("should have updated dates", function() {
    expect(res.body.data.startDate).to.equal("2025-02-01");
    expect(res.body.data.endDate).to.equal("2025-11-30");
  });

  test("should have correct message", function() {
    expect(res.body.message).to.equal("Subscription updated successfully");
  });
}

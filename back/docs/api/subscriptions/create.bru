meta {
  name: Create Subscription
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/subscriptions
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "parkingId": "{{parkingId}}",
    "rateId": "{{rateId}}",
    "startDate": "2025-01-01",
    "endDate": "2025-12-31",
    "weeklySlots": [
      {"dayOfWeek": "monday", "startHour": "08:00", "endHour": "18:00"},
      {"dayOfWeek": "wednesday", "startHour": "08:00", "endHour": "18:00"}
    ]
  }
}

script:post-response {
  console.log("response", res.body);
  if (res.body.data && res.body.data.id) {
    bru.setVar("subscriptionId", res.body.data.id);
  }
}

tests {
  test("should return 201 on successful creation", function() {
    expect(res.status).to.equal(201);
  });

  test("should have success status", function() {
    expect(res.body.status).to.equal("success");
  });

  test("should return subscription data", function() {
    expect(res.body.data).to.have.property("id");
    expect(res.body.data).to.have.property("userId");
    expect(res.body.data).to.have.property("parkingId");
    expect(res.body.data).to.have.property("rateId");
    expect(res.body.data).to.have.property("startDate");
    expect(res.body.data).to.have.property("endDate");
    expect(res.body.data).to.have.property("weeklySlots");
  });

  test("should have correct dates", function() {
    expect(res.body.data.startDate).to.equal("2025-01-01");
    expect(res.body.data.endDate).to.equal("2025-12-31");
  });
}

meta {
  name: Cancel Subscription
  type: http
  seq: 5
}

delete {
  url: {{baseUrl}}/api/subscriptions/{{subscriptionId}}
  body: none
  auth: none
}

script:post-response {
  console.log("response", res.body);
}

tests {
  test("should return 200 on successful cancellation", function() {
    expect(res.status).to.equal(200);
  });

  test("should have success status", function() {
    expect(res.body.status).to.equal("success");
  });

  test("should have correct message", function() {
    expect(res.body.message).to.equal("Subscription cancelled successfully");
  });
}

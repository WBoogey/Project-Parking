meta {
  name: Get Customer Subscriptions
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/customer/subscriptions
  body: none
  auth: none
}

script:post-response {
  console.log("response", res.body);
}

tests {
  test("should return 200 when authenticated as customer", function() {
    expect(res.status).to.equal(200);
  });

  test("should have success status", function() {
    expect(res.body.status).to.equal("success");
  });

  test("should return subscriptions array", function() {
    expect(res.body.data).to.be.an("array");
  });

  test("should have correct subscription structure if data exists", function() {
    if (res.body.data.length > 0) {
      const subscription = res.body.data[0];
      expect(subscription).to.have.property("id");
      expect(subscription).to.have.property("startDate");
      expect(subscription).to.have.property("endDate");
      expect(subscription).to.have.property("rate");
      expect(subscription).to.have.property("weeklySlots");
      expect(subscription).to.have.property("parkingId");
      expect(subscription).to.have.property("userId");
    }
  });
}

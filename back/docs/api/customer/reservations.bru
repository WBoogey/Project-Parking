meta {
  name: Get Reservations
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/customer/reservations
  body: none
  auth: none
}

script:post-response {
  console.log("response", res.body);
}

tests {
  test("should return 200 when authenticated", function() {
    expect(res.status).to.equal(200);
  });

  test("should have success status", function() {
    expect(res.body.status).to.equal("success");
  });

  test("should return reservations array", function() {
    expect(res.body.data).to.be.an("array");
  });

  test("should have correct message", function() {
    expect(res.body.message).to.equal("Customer reservations");
  });

  test("reservations should have correct structure", function() {
    if (res.body.data.length > 0) {
      const reservation = res.body.data[0];
      expect(reservation).to.have.property("id");
      expect(reservation).to.have.property("dayOfWeek");
      expect(reservation).to.have.property("startHour");
      expect(reservation).to.have.property("endHour");
      expect(reservation).to.have.property("parkingId");
      expect(reservation).to.have.property("userId");
    }
  });
}

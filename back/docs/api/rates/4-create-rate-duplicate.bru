meta {
  name: 4. Create Rate Duplicate
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/owner/parkings/{{parkingId}}/rates
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "type": "yearly_subscription",
    "price": 999.99,
    "calculationRule": "fixed"
  }
}

script:post-response {
  console.log("response", res.body);
}

tests {
  test("should return 422 for duplicate rate type", function() {
    expect(res.status).to.equal(422);
  });

  test("should have error type", function() {
    expect(res.body.type).to.equal("https://httpstatuses.com/422");
  });

  test("should have Unprocessable Entity title", function() {
    expect(res.body.title).to.equal("Unprocessable Entity");
  });

  test("should mention duplicate rate type in detail", function() {
    expect(res.body.detail).to.include("already exists");
    expect(res.body.detail).to.include("yearly_subscription");
  });

  test("should have status 422 in body", function() {
    expect(res.body.status).to.equal(422);
  });
}

meta {
  name: 6. Delete Rate
  type: http
  seq: 6
}

delete {
  url: {{baseUrl}}/api/owner/parkings/{{parkingId}}/rates/{{newRateId}}
  body: none
  auth: none
}

script:post-response {
  console.log("response", res.body);
}

tests {
  test("should return 200 on successful deletion", function() {
    expect(res.status).to.equal(200);
  });

  test("should have success status", function() {
    expect(res.body.status).to.equal("success");
  });

  test("should have correct message", function() {
    expect(res.body.message).to.equal("Rate deleted successfully");
  });

  test("should return empty data array", function() {
    expect(res.body.data).to.be.an("array");
    expect(res.body.data).to.have.lengthOf(0);
  });
}

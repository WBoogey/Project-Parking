meta {
  name: Get Reservation Details
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/reservations/{{reservationId}}
  body: none
  auth: none
}

headers {
  Content-Type: application/json
}

script:post-response {
  console.log("response", res.body);
}

tests {
  test("should return 200", function() {
    expect(res.status).to.equal(200);
  });

  test("should have success status", function() {
    expect(res.body.status).to.equal("success");
  });

  test("should return reservation details", function() {
    expect(res.body.data).to.have.property("id");
    expect(res.body.data).to.have.property("userId");
    expect(res.body.data).to.have.property("parkingId");
    expect(res.body.data).to.have.property("startTime");
    expect(res.body.data).to.have.property("endTime");
    expect(res.body.data).to.have.property("status");
  });
}

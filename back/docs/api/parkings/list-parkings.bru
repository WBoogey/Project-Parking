meta {
  name: List All Parkings
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/parkings
  body: none
  auth: none
}

script:post-response {
  console.log("response", res.body);

  // Store first parking ID for other tests
  if (res.body.data && res.body.data.length > 0) {
    bru.setEnvVar("parkingId", res.body.data[0].parking.id);

    // Store first rate ID if available
    if (res.body.data[0].rates && res.body.data[0].rates.length > 0) {
      bru.setEnvVar("rateId", res.body.data[0].rates[0].id);
    }
  }
}

tests {
  test("should return 200", function() {
    expect(res.status).to.equal(200);
  });

  test("should have success status", function() {
    expect(res.body.status).to.equal("success");
  });

  test("should return parkings array", function() {
    expect(res.body.data).to.be.an("array");
  });

  test("should have correct message", function() {
    expect(res.body.message).to.equal("Parkings retrieved successfully");
  });

  test("each item should have parking and rates", function() {
    if (res.body.data.length > 0) {
      const item = res.body.data[0];
      expect(item).to.have.property("parking");
      expect(item).to.have.property("rates");
      expect(item.rates).to.be.an("array");
    }
  });

  test("parking should have required fields", function() {
    if (res.body.data.length > 0) {
      const parking = res.body.data[0].parking;
      expect(parking).to.have.property("id");
      expect(parking).to.have.property("location");
      expect(parking).to.have.property("capacity");
      expect(parking).to.have.property("ownerId");
    }
  });

  test("rate should have required fields", function() {
    if (res.body.data.length > 0 && res.body.data[0].rates.length > 0) {
      const rate = res.body.data[0].rates[0];
      expect(rate).to.have.property("id");
      expect(rate).to.have.property("parkingId");
      expect(rate).to.have.property("type");
      expect(rate).to.have.property("price");
      expect(rate).to.have.property("calculationRule");
    }
  });
}

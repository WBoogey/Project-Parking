meta {
  name: Exit Parking
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/stationings/exit
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "parkingId": "{{parkingId}}"
  }
}

script:post-response {
  console.log("response", res.body);
}

tests {
  test("should return 200 on successful exit", function() {
    expect(res.status).to.equal(200);
  });

  test("should have success status", function() {
    expect(res.body.status).to.equal("success");
  });

  test("should return stationing data with end time", function() {
    expect(res.body.data).to.have.property("id");
    expect(res.body.data).to.have.property("endTime");
    expect(res.body.data.status).to.equal("completed");
    expect(res.body.data).to.have.property("amount");
  });

  test("should have payment info if not free", function() {
    if (!res.body.data.isFree) {
      expect(res.body.data).to.have.property("checkoutUrl");
    }
  });
}
